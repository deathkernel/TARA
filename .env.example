# Local language-model inference through Ollama.
# Install/start Ollama separately and pull the model you want; TARA does not download it.
TARA_LLM_BACKEND=ollama
TARA_LLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://127.0.0.1:11434
TARA_LLM_TIMEOUT_SECONDS=120

# Resource profile: eco (default), balanced, or performance.
TARA_POWER_MODE=eco
# Optional resource overrides. Leave commented to use profile defaults.
# TARA_OLLAMA_NUM_CTX=2048
# TARA_OLLAMA_NUM_THREADS=4
# TARA_OLLAMA_NUM_BATCH=64
# TARA_OLLAMA_KEEP_ALIVE=2m

# Maximum response length override. Leave unset to use the profile default.
# TARA_MAX_RESPONSE_TOKENS=128

# Optional ElevenLabs voice output; enabled only when both values are configured.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=4cLxTzxGs6YiIomdhhqO
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
