# Local conversation backend
TARA_LLM_BACKEND=ollama
TARA_LLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://127.0.0.1:11434
TARA_LLM_TIMEOUT_SECONDS=120
TARA_POWER_MODE=eco
TARA_MAX_RESPONSE_TOKENS=128

# Local persistent memory. Never store secrets in memory values.
TARA_MEMORY_PATH=data/tara_memory.json

# Optional resource overrides. Leave commented unless you know your machine's limits.
# TARA_OLLAMA_NUM_CTX=2048
# TARA_OLLAMA_NUM_THREADS=4
# TARA_OLLAMA_NUM_BATCH=64
# TARA_OLLAMA_KEEP_ALIVE=2m
