# Optional hosted reasoning backend for TARA
# Copy to your shell environment; do not commit the real key.
GROQ_API_KEY=
# Optional TARA-side safety budgets:
TARA_GROQ_MODEL=openai/gpt-oss-20b
TARA_GROQ_MAX_DAILY_REQUESTS=20
TARA_GROQ_MAX_DAILY_TOKENS=50000
TARA_GROQ_MAX_COMPLETION_TOKENS=1024

# Optional ElevenLabs voice output
# TARA uses these only when both values are configured.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=4cLxTzxGs6YiIomdhhqO
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Local web API only (ignored outside non-production runtimes).
# Use a local PostgreSQL database and a dedicated non-owner runtime role.
TARA_DATABASE_URL=postgres://tara_runtime:change-me@127.0.0.1:5432/tara
TARA_DEV_USER_ID=00000000-0000-4000-8000-000000000001
